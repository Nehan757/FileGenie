# FileGenie Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
ALLOWED_HOSTS=http://localhost:3000,https://yourdomain.com

# Google API Configuration (for document processing)
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Configuration (for AI processing)
GROQ_API_KEY=your_groq_api_key_here

# Security
SECRET_KEY=your-super-secret-production-key-here-make-it-long-and-random

# Database Configuration (when using Supabase)
# SUPABASE_URL=your_supabase_project_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=application/pdf
UPLOAD_DIRECTORY=./uploads

# Session Configuration
SESSION_SECRET=your-session-secret-key-here

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100